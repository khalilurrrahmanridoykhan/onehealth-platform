ONEHEALTH_BACKEND=dhis2
ONEHEALTH_DATA_PATH=/app/data/processed/dengue_weekly.csv
ONEHEALTH_DATA_PATHS=/app/data/processed/dengue_weekly.csv,/app/data/processed/measles_weekly.csv,/app/data/processed/hpai_semester.csv,/app/data/processed/nipah_annual.csv,/app/data/processed/je_annual.csv,/app/data/processed/awd_annual.csv,/app/data/processed/rabies_annual.csv,/app/data/processed/malaria_annual.csv
ONEHEALTH_EVIDENCE_REGISTRY_PATH=/app/data/evidence_registry.json
ONEHEALTH_DOMAIN=health.example.org
DHIS2_DOMAIN=dhis2.example.org
DHIS2_BOOTSTRAP_HASH=replace-with-a-caddy-password-hash
ONEHEALTH_CORS_ORIGINS=https://health.example.org
ONEHEALTH_EBS_READS_ENABLED=false
ONEHEALTH_EBS_WRITES_ENABLED=false
ONEHEALTH_AUTH_SECRET=replace-with-at-least-32-random-characters
ONEHEALTH_AUTH_USERS=[]
ONEHEALTH_CACHE_TTL_SECONDS=300
ONEHEALTH_CACHE_STALE_IF_ERROR_SECONDS=86400
DHIS2_BASE_URL=https://dhis2.example.org
DHIS2_API_TOKEN=
DHIS2_VERIFY_SSL=true
DHIS2_TIMEOUT_SECONDS=30
DHIS2_MAPPING_PATH=/app/dhis2/mappings/dengue.json
DHIS2_MAPPING_PATHS=/app/dhis2/mappings/dengue.json,/app/dhis2/mappings/measles.json,/app/dhis2/mappings/hpai.json,/app/dhis2/mappings/nipah.json,/app/dhis2/mappings/je.json,/app/dhis2/mappings/awd.json,/app/dhis2/mappings/rabies.json,/app/dhis2/mappings/malaria.json
DHIS2_START_DATE=2020-01-01
DHIS2_END_DATE=2026-12-31
POSTGRES_DB=dhis2
POSTGRES_USER=dhis
POSTGRES_PASSWORD=replace-with-a-random-database-password
