# csv keeps the current local demonstration backend; dhis2 reads API data from DHIS2.
ONEHEALTH_BACKEND=csv
ONEHEALTH_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# DHIS2 instance configuration
DHIS2_BASE_URL=http://localhost:8080
DHIS2_API_TOKEN=
DHIS2_USERNAME=
DHIS2_PASSWORD=
DHIS2_VERIFY_SSL=true
DHIS2_TIMEOUT_SECONDS=30
DHIS2_MAPPING_PATH=dhis2/mappings/dengue.json
DHIS2_START_DATE=2020-01-01
DHIS2_END_DATE=2026-12-31
