{$ONEHEALTH_DOMAIN} {
    encode zstd gzip
    reverse_proxy web:8080
    header Strict-Transport-Security "max-age=31536000; includeSubDomains"
}

{$DHIS2_DOMAIN} {
    encode zstd gzip
    basic_auth {
        setup {$DHIS2_BOOTSTRAP_HASH}
    }
    reverse_proxy dhis2:8080 {
        # The temporary bootstrap gate and DHIS2 both use Authorization.
        # Validate the gate here, then let DHIS2 handle its own form session.
        header_up -Authorization
        # DHIS2/Tomcat may emit an internal HTTP redirect behind TLS termination.
        header_down Location "^http://" "https://"
    }
    header Strict-Transport-Security "max-age=31536000; includeSubDomains"
}
